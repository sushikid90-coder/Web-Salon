from flask import Flask, request, redirect, url_for, render_template_string
import sqlite3
from datetime import datetime

app = Flask(__name__)
DB = "bookings.db"

def init_db():
    with sqlite3.connect(DB) as con:
        con.execute("""
        CREATE TABLE IF NOT EXISTS bookings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at TEXT NOT NULL,
            name TEXT NOT NULL,
            phone TEXT NOT NULL,
            date TEXT NOT NULL,
            time TEXT NOT NULL,
            service TEXT NOT NULL,
            combo TEXT,
            note TEXT
        )
        """)

init_db()

PAGE = """
<!doctype html>
<html>
<head><meta charset="utf-8"><title>Đặt lịch Salon</title></head>
<body>
<h2>Đặt lịch</h2>
<form method="post" action="/book">
<input name="name" placeholder="Tên"><br>
<input name="phone" placeholder="SĐT"><br>
<input type="date" name="date"><br>
<input type="time" name="time"><br>
<input name="service" placeholder="Dịch vụ"><br>
<input name="combo" placeholder="Combo"><br>
<textarea name="note" placeholder="Ghi chú"></textarea><br>
<button>Đặt lịch</button>
</form>
</body>
</html>
"""

ADMIN = """
<h2>Admin</h2>
{% if not ok %}
<form>
<input name="key" placeholder="Key">
<button>Vào</button>
</form>
{% else %}
<table border=1>
<tr><th>ID</th><th>Tên</th><th>SĐT</th><th>Ngày</th><th>Giờ</th></tr>
{% for r in rows %}
<tr><td>{{r[0]}}</td><td>{{r[2]}}</td><td>{{r[3]}}</td><td>{{r[4]}}</td><td>{{r[5]}}</td></tr>
{% endfor %}
</table>
{% endif %}
"""

@app.get("/")
def home():
    return render_template_string(PAGE)

@app.post("/book")
def book():
    name = request.form.get("name")
    phone = request.form.get("phone")
    date = request.form.get("date")
    time = request.form.get("time")
    service = request.form.get("service")
    combo = request.form.get("combo")
    note = request.form.get("note")

    with sqlite3.connect(DB) as con:
        con.execute(
            "INSERT INTO bookings(created_at,name,phone,date,time,service,combo,note) VALUES (?,?,?,?,?,?,?,?)",
            (datetime.now().isoformat(), name, phone, date, time, service, combo, note)
        )
    return redirect("/")

@app.get("/admin")
def admin():
    key = request.args.get("key","")
    ok = key == "1234"
    rows = []
    if ok:
        with sqlite3.connect(DB) as con:
            rows = con.execute("SELECT * FROM bookings").fetchall()
    return render_template_string(ADMIN, ok=ok, rows=rows)

if _name_ == "_main_":
    print(">>> APP STARTING <<<")
    app.run(host="127.0.0.1", port=5000, debug=True)
